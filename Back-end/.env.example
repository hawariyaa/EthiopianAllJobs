OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-haiku-5.5
DATABASE_URL=postgresql+psycopg://alljobs:alljobs@localhost:5433/alljobs
# LinkedIn jobs via JSearch (Google for Jobs) on RapidAPI; leave blank to disable
JSEARCH_API_KEY=
# Searches separated by "|"; each costs one request per page (up to 2 pages).
# Say "linkedin" in them: plain searches return almost no LinkedIn jobs. The free plan allows 200 requests a month.
JSEARCH_QUERIES=linkedin jobs in Addis Ababa|linkedin jobs in Ethiopia
# Hour of the daily scrape, Addis Ababa time
SCRAPE_HOUR=6
# Set to true when the site is served over HTTPS
COOKIE_SECURE=false
REQUEST_DELAY_SECONDS=1.5
MATCH_THRESHOLD=60
